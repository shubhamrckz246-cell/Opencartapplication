

<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="OpenCart All Groups Suite">

    <listeners>
        <listener class-name="utils.ExtentReportManager"/>
    </listeners>

    <!-- SANITY TESTS -->
    <test name="Sanity Tests">

        <parameter name="os" value="Windows"/>
        <parameter name="browser" value="chrome"/>

        <groups>
            <run>
                <include name="sanity"/>
            </run>
        </groups>

        <classes>
            <class name="testCases.TC_001Homepage"/>
            <class name="testCases.TC_002AccountRegisteration"/>
            <class name="testCases.TC_003Login"/>
            <class name="testCases.TC_005loginDDT"/>
        </classes>

    </test>

    <!-- REGRESSION TESTS -->
    <test name="Regression Tests">

        <parameter name="os" value="Windows"/>
        <parameter name="browser" value="chrome"/>

        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>

        <classes>
            <class name="testCases.TC_001Homepage"/>
            <class name="testCases.TC_002AccountRegisteration"/>
            <class name="testCases.TC_003Login"/>
            <class name="testCases.TC_005loginDDT"/>
        </classes>

    </test>

    <!-- MASTER TESTS -->
    <test name="Master Tests">

        <parameter name="os" value="Windows"/>
        <parameter name="browser" value="chrome"/>

        <groups>
            <run>
                <include name="master"/>
            </run>
        </groups>

        <classes>
            <class name="testCases.TC_001Homepage"/>
            <class name="testCases.TC_002AccountRegisteration"/>
            <class name="testCases.TC_003Login"/>
            <class name="testCases.TC_005loginDDT"/>
        </classes>

    </test>

</suite>
